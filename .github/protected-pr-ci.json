{
  "version": 1,
  "default_branch": "main",
  "workflow_file": ".github/workflows/pr-ci.yml",
  "required_check": "Required CI",
  "release_app": {
    "enabled": false,
    "login": "nvidia-yamlsigil-release-pr[bot]",
    "slug": "nvidia-yamlsigil-release-pr",
    "head_ref": "release-plz-next",
    "allowed_paths": []
  },
  "expected_jobs": [
    "commit_policy",
    "workflow_lint",
    "markdown",
    "contracts",
    "rebuild_rs"
  ],
  "sensitive_paths": [
    "CODEOWNERS",
    "**/CODEOWNERS",
    ".github/**",
    ".cargo/**",
    "rust-toolchain",
    "rust-toolchain.toml",
    "**/rust-toolchain",
    "**/rust-toolchain.toml",
    "rustfmt.toml",
    ".rustfmt.toml",
    "**/rustfmt.toml",
    "**/.rustfmt.toml",
    "clippy.toml",
    ".clippy.toml",
    "**/clippy.toml",
    "**/.clippy.toml",
    ".rumdl.toml",
    "rumdl.toml",
    ".markdownlint.json",
    ".markdownlint.yaml",
    "Cargo.toml",
    "Cargo.lock",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "AGENTS.md",
    "**/AGENTS.md",
    ".agents/**",
    "**/.agents/**",
    "RELEASING.md",
    ".release-plz.toml",
    "release-plz.toml",
    "proto/buf.yaml",
    "proto/buf.lock",
    "proto/buf.gen.yaml",
    "conformance/rebuild-rs/xtask/**"
  ]
}
